{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "value", "dialect", "context", "compatibility", "params"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^MAV_CMD_[A-Z0-9_]*$" },
    "value": { "type": "integer", "minimum": 0 },
    "dialect": { "const": "common" },
    "context": { "enum": ["mission", "command"] },
    "notes": { "$ref": "compatibility-entry.schema.json#/$defs/notes" },
    "compatibility": { "$ref": "compatibility-entry.schema.json#/$defs/commandCompatibility" },
    "params": {
      "description": "Keyed by '<index>_<name>' (e.g. '1_Pitch') -- index and name are encoded in the key, not repeated as separate fields. May be empty for a command with no upstream params at all.",
      "type": "object",
      "propertyNames": { "pattern": "^[1-7]_.+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enumRef"],
        "properties": {
          "enumRef": { "type": ["string", "null"] },
          "notes": { "$ref": "compatibility-entry.schema.json#/$defs/notes" }
        }
      }
    }
  }
}
